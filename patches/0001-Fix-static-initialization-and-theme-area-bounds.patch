+/* Filled at call time: Palette::YellowDark is mutable (themes), so reading it
+ * in a static initializer would need a dynamic initializer, which never runs
+ * on device (no .init_array). MessageView copies the colors. */
+static const KDColor* USBConnectedColors() {
+  static KDColor s_colors[] = {KDColorBlack, KDColorBlack, KDColorBlack,
+                               KDColorBlack, KDColorWhite, KDColorBlack,
+                               KDColorBlack, KDColorBlack};
+  s_colors[3] = Escher::Palette::YellowDark;
+  return s_colors;
+}
 
 USBConnectedController::USBConnectedController()
     : ViewController(nullptr),
-      m_messageView(sUSBConnectedMessages, sUSBConnectedColors, 8) {}
+      m_messageView(sUSBConnectedMessages, USBConnectedColors(), 8) {}
 
